# Copy this file to .env.local and fill in your TEST keys first.
# Never commit .env.local. On Vercel, add these under Project Settings > Environment Variables.

# The public URL of your site, used for payment callbacks (no trailing slash)
SITE_URL=http://localhost:3000

# Paystack: Dashboard > Settings > API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Flutterwave: Dashboard > Settings > API Keys
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
# Flutterwave: Dashboard > Settings > Webhooks > Secret hash (a string you choose)
FLW_SECRET_HASH=choose-a-long-random-string

# Postgres, required with live keys so each payment is fulfilled exactly once across
# server instances. Optional for local development and test-mode demos.
# DATABASE_URL=postgres://user:password@host:6543/postgres
